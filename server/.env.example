# Скопируйте в server/.env и заполните. Файл .env в репозиторий не попадает.

# Сервер
HOST=127.0.0.1
PORT=8080
# Папка с базой заявок и фото (относительно корня проекта)
DATA_DIR=data
# 1: сервер сам раздаёт сайт (один домен для сайта и API). 0: только API (сайт на Vercel).
SERVE_STATIC=1
# Домены сайта, которым можно отправлять форму на этот API (нужно, если сайт на другом домене, например Vercel)
ALLOWED_ORIGINS=https://life-light-architecture.vercel.app
# 1, если сервер стоит за nginx (берём IP из X-Forwarded-For)
TRUST_PROXY=1
# Любая длинная случайная строка: IP посетителей хранятся только в виде хеша
IP_SALT=замените-на-случайную-строку
# Не больше N заявок с одного IP за M минут
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# Telegram-бот (токен выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=
# Адрес Cloudflare Worker из worker/ (без слеша в конце). Пусто: напрямую api.telegram.org
TELEGRAM_API_BASE=https://life-light-tg-proxy.ВАШ-АККАУНТ.workers.dev
# Тот же секрет, что PROXY_SECRET в Worker
TELEGRAM_PROXY_SECRET=
# ID группы менеджеров, куда приходят заявки (узнать: добавить бота в группу и написать /id)
TELEGRAM_CHAT_ID=
# Через запятую: ID людей, которым можно управлять ботом в личных сообщениях (необязательно)
TELEGRAM_ADMIN_IDS=
# polling (по умолчанию, ничего не нужно открывать наружу) | webhook | off
TELEGRAM_MODE=polling
# Только для webhook: адрес Worker /webhook и общий секрет
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Час (по Москве), когда бот присылает ежедневный отчёт. Пусто: не присылать
DAILY_REPORT_HOUR=10
REPORT_TZ=Europe/Moscow

# Яндекс Метрика для статистики в боте (docs/metrika.md)
METRIKA_COUNTER_ID=
METRIKA_TOKEN=
# Номер цели «Заявка отправлена» (lead_sent) из настроек счётчика
METRIKA_LEAD_GOAL_ID=
